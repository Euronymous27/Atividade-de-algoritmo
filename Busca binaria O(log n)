

import time

def busca_binaria(lista, alvo):
    inicio = 0
    fim = len(lista) - 1
    while inicio <= fim:
        meio = (inicio + fim) // 2
        if lista[meio] == alvo:
            return meio
        elif lista[meio] < alvo:
            inicio = meio + 1
        else:
            fim = meio - 1
    return -1

# Teste
if __name__ == "__main__":
    dados = list(range(0, 10_000_000))
    alvo = 9999999

    inicio = time.time()
    indice = busca_binaria(dados, alvo)
    fim = time.time()

    print(f"Elemento encontrado no índice: {indice}")
    print(f"Tempo de execução: {fim - inicio:.6f} segundos")
