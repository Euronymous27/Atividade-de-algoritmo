
import time
import random

def selection_sort(lista):
    n = len(lista)
    for i in range(n):
        menor = i
        for j in range(i + 1, n):
            if lista[j] < lista[menor]:
                menor = j
        lista[i], lista[menor] = lista[menor], lista[i]
    return lista

# Teste
if __name__ == "__main__":
    dados = random.sample(range(0, 1000), 1000)

    inicio = time.time()
    ordenada = selection_sort(dados)
    fim = time.time()

    print(f"Lista ordenada corretamente? {ordenada == sorted(dados)}")
    print(f"Tempo de execução: {fim - inicio:.6f} segundos")
